# The development TLS generator includes the Docker service name `mosquitto` as a SAN.
# Regenerate the certificate with scripts/generate_tls.sh before using this setting.
NS_MQTT_HOST=mosquitto
NS_MQTT_PORT=8883
NS_MQTT_USERNAME=gcp-bridge
NS_MQTT_PASSWORD=replace-with-bridge-password
NS_MQTT_TOPIC_ROOT=network-sentinel
NS_MQTT_CA_CERT=/mosquitto/certs/ca.crt
GOOGLE_APPLICATION_CREDENTIALS=/var/run/secrets/gcp.json
NS_GCP_BQ_PACKET_TABLE=PROJECT_ID.network_sentinel.packet_metadata
NS_GCP_BQ_MANIFEST_TABLE=PROJECT_ID.network_sentinel.capture_manifests
NS_GCP_BQ_HEALTH_TABLE=PROJECT_ID.network_sentinel.pipeline_health
NS_GCP_SPOOL_PATH=/var/lib/network-sentinel/gcp-bridge/spool.sqlite3
NS_GCP_SPOOL_MAX_BYTES=1073741824
NS_GCP_SPOOL_POLL_SECONDS=1
NS_GCP_RETRY_BASE_SECONDS=5
NS_GCP_RETRY_MAX_SECONDS=3600
# Optional: set a bucket to also retain JSON manifests, not PCAP files.
NS_GCP_MANIFEST_BUCKET=
