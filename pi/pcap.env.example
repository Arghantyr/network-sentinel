# Interface must be the Pi interface that carries its own traffic (check: ip -br link).
NS_CAPTURE_INTERFACE=eth0
# BPF filter: do not capture administration/control-plane traffic by default.
NS_CAPTURE_FILTER="not port 22 and not port 8883"
NS_PCAP_DIRECTORY=/var/lib/network-sentinel/pcap
NS_PCAP_ROTATE_SECONDS=60
NS_PCAP_MAX_FILES=60
NS_PCAP_MIN_AGE_SECONDS=10
NS_PCAP_BATCH_SIZE=100
# Publish privacy-preserving operational health at this interval (minimum 10 seconds).
NS_HEALTH_REPORT_SECONDS=60
