[Unit]
Description=Network Sentinel Pi pipeline health reporter
After=network-online.target network-sentinel-pcap-export.service
Wants=network-online.target

[Service]
User=sentinel
Group=sentinel
WorkingDirectory=/opt/network-sentinel
EnvironmentFile=/etc/network-sentinel/mqtt.env
EnvironmentFile=/etc/network-sentinel/pcap.env
ExecStart=/opt/network-sentinel/.venv/bin/python /opt/network-sentinel/pi/health_reporter.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/network-sentinel

[Install]
WantedBy=multi-user.target
