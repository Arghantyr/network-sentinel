NS_DEVICE_ID=pi-4
NS_MQTT_HOST=mqtt.example.net
NS_MQTT_PORT=8883
NS_MQTT_USERNAME=pi-4
NS_MQTT_PASSWORD=replace-with-a-long-random-secret
NS_MQTT_TOPIC_ROOT=network-sentinel
# Set this when using the private CA generated by infra/mqtt/scripts/generate_tls.sh
NS_MQTT_CA_CERT=/etc/network-sentinel/ca.crt
